{
  "schema": "albie.scene/1",
  "space": "volume",
  "view": {
    "radius": 0.5
  },
  "generators": [],
  "nodes": [
    {
      "id": "pad",
      "kind": "primitive",
      "shape": "cylinder",
      "size": [
        0.16,
        0.02,
        0.16
      ],
      "pos": [
        0,
        -0.49,
        -0.15
      ],
      "color": "#3A4152"
    },
    {
      "id": "blast_plate",
      "kind": "primitive",
      "shape": "cylinder",
      "size": [
        0.05,
        0.004,
        0.05
      ],
      "pos": [
        0,
        -0.478,
        -0.15
      ],
      "color": "#9AA3B5"
    },
    {
      "id": "rod",
      "kind": "primitive",
      "shape": "cylinder",
      "size": [
        0.004,
        0.225,
        0.004
      ],
      "pos": [
        0,
        -0.368,
        -0.14
      ],
      "rot": [
        5,
        0,
        0
      ],
      "color": "#C9CED6"
    },
    {
      "id": "flight",
      "kind": "sim",
      "solver": "rocket",
      "pos": [
        0,
        -0.48,
        -0.15
      ],
      "rate": 1,
      "params": {
        "body_length": "$body_length",
        "body_diameter": "$body_diameter",
        "nose_length": "$nose_length",
        "nose_cone": "$nose_cone",
        "fin_count": "$fin_count",
        "fin_root": "$fin_root",
        "fin_tip": "$fin_tip",
        "fin_span": "$fin_span",
        "fin_sweep": "$fin_sweep",
        "wind_mps": "$wind_mps",
        "scale": 0.005,
        "descent_speedup": 8,
        "countdown_s": 3,
        "step": 0.02,
        "draw_scale": 0.25
      },
      "bodies": [
        {
          "node": "rocket"
        },
        {
          "node": "apogee_mark"
        },
        {
          "node": "cg_mark"
        },
        {
          "node": "cp_mark"
        }
      ]
    },
    {
      "id": "rocket",
      "kind": "primitive",
      "parent": "flight",
      "shape": "cylinder",
      "size": [
        0.01,
        0.1,
        0.01
      ],
      "pos": [
        0,
        0.05,
        0
      ],
      "color": "#E8ECF2"
    },
    {
      "id": "trail",
      "kind": "line",
      "parent": "flight",
      "follow": "rocket",
      "length": 900,
      "width": 0.006,
      "color": "#FFB547"
    },
    {
      "id": "chute",
      "kind": "primitive",
      "parent": "flight",
      "shape": "sphere",
      "size": [
        0.09,
        0.035,
        0.09
      ],
      "color": "#FF6A3D",
      "visible": false
    },
    {
      "id": "apogee_mark",
      "kind": "primitive",
      "parent": "flight",
      "shape": "sphere",
      "size": [
        0.02,
        0.02,
        0.02
      ],
      "pos": [
        0,
        0.98,
        0.04
      ],
      "color": "#FFD24C",
      "glow": true
    },
    {
      "id": "apogee_label",
      "kind": "text",
      "parent": "apogee_mark",
      "text": "Apogee {apogee_m} m",
      "height": 0.03,
      "pos": [
        0,
        0.05,
        0
      ],
      "color": "#FFD24C",
      "billboard": true
    },
    {
      "id": "cg_mark",
      "kind": "primitive",
      "parent": "flight",
      "shape": "sphere",
      "size": [
        0.014,
        0.014,
        0.014
      ],
      "pos": [
        0,
        0.06,
        0
      ],
      "color": "#FFFFFF",
      "glow": true
    },
    {
      "id": "cp_mark",
      "kind": "primitive",
      "parent": "flight",
      "shape": "sphere",
      "size": [
        0.014,
        0.014,
        0.014
      ],
      "pos": [
        0,
        0.04,
        0
      ],
      "color": "#FF4D4D",
      "glow": true
    },
    {
      "id": "status_label",
      "kind": "text",
      "text": "On the pad. Press Launch.",
      "height": 0.03,
      "pos": [
        0,
        -0.38,
        -0.34
      ],
      "billboard": true
    },
    {
      "id": "model_label",
      "kind": "text",
      "text": "Flight: simplified model",
      "height": 0.018,
      "pos": [
        0,
        -0.42,
        -0.34
      ],
      "color": "#AEB6C6",
      "billboard": true
    },
    {
      "id": "scale_label",
      "kind": "text",
      "text": "Flight path 1:200",
      "height": 0.018,
      "pos": [
        0,
        -0.45,
        -0.34
      ],
      "color": "#AEB6C6",
      "billboard": true
    },
    {
      "id": "controls",
      "kind": "panel",
      "title": "Rocket launch",
      "widgets": [
        {
          "type": "note",
          "text": "Your model rocket on a C6-5 motor, launched from the pad on your desk. Press Launch: a 3 second countdown, then the simulated flight, drawn at 1:200 (1 m above the pad is 200 m of sky; the rocket itself is drawn at 1:4 so you can see it). The burn and climb play in real time, the parachute descent 8x faster. The white dot on the rocket is its centre of gravity, the red one its centre of pressure: the further the white sits ahead of the red, the more stable. Under 1.0 calibre fails, since a real rocket that unstable would likely tumble. The line under the pad says which simulation flew: RocketPy for your CAD design when the cloud has it, otherwise a simplified point-mass model. Each landing is saved as a run."
        },
        {
          "type": "stat",
          "metric": "altitude_m",
          "label": "Altitude",
          "unit": "m",
          "decimals": 0
        },
        {
          "type": "stat",
          "metric": "speed_mps",
          "label": "Speed",
          "unit": "m/s",
          "decimals": 0
        },
        {
          "type": "stat",
          "metric": "time",
          "label": "Time",
          "unit": "s",
          "decimals": 1
        },
        {
          "type": "stat",
          "metric": "apogee_m",
          "label": "Apogee (simulated)",
          "unit": "m",
          "decimals": 0
        },
        {
          "type": "stat",
          "metric": "stability_cal",
          "label": "Stability margin (1.0 to pass)",
          "unit": "cal",
          "decimals": 2
        },
        {
          "type": "stat",
          "metric": "max_speed_mps",
          "label": "Top speed",
          "unit": "m/s",
          "decimals": 0
        },
        {
          "type": "stat",
          "metric": "flight_time_s",
          "label": "Flight time",
          "unit": "s",
          "decimals": 1
        },
        {
          "type": "stat",
          "metric": "drift_m",
          "label": "Lands from the pad",
          "unit": "m",
          "decimals": 0
        },
        {
          "type": "button",
          "id": "launch",
          "label": "Launch",
          "primary": true
        },
        {
          "type": "button",
          "id": "reset",
          "label": "Back on the pad"
        },
        {
          "type": "runs",
          "columns": [
            "apogee_m",
            "stability_cal",
            "flight_time_s"
          ],
          "limit": 5
        },
        {
          "type": "slider",
          "input": "fin_count"
        },
        {
          "type": "slider",
          "input": "fin_span"
        },
        {
          "type": "slider",
          "input": "fin_root"
        },
        {
          "type": "slider",
          "input": "fin_tip"
        },
        {
          "type": "slider",
          "input": "fin_sweep"
        },
        {
          "type": "slider",
          "input": "body_length"
        },
        {
          "type": "slider",
          "input": "body_diameter"
        },
        {
          "type": "slider",
          "input": "nose_length"
        },
        {
          "type": "slider",
          "input": "nose_cone"
        },
        {
          "type": "slider",
          "input": "wind_mps"
        }
      ]
    }
  ],
  "rules": [
    {
      "type": "metric",
      "name": "altitude_m",
      "op": "sim",
      "sim": "flight",
      "value": "altitude_m"
    },
    {
      "type": "metric",
      "name": "speed_mps",
      "op": "sim",
      "sim": "flight",
      "value": "speed_mps"
    },
    {
      "type": "metric",
      "name": "time",
      "op": "sim",
      "sim": "flight",
      "value": "time"
    },
    {
      "type": "metric",
      "name": "apogee_m",
      "op": "sim",
      "sim": "flight",
      "value": "apogee_m"
    },
    {
      "type": "metric",
      "name": "stability_cal",
      "op": "sim",
      "sim": "flight",
      "value": "stability_cal"
    },
    {
      "type": "metric",
      "name": "max_speed_mps",
      "op": "sim",
      "sim": "flight",
      "value": "max_speed_mps"
    },
    {
      "type": "metric",
      "name": "time_to_apogee_s",
      "op": "sim",
      "sim": "flight",
      "value": "time_to_apogee_s"
    },
    {
      "type": "metric",
      "name": "flight_time_s",
      "op": "sim",
      "sim": "flight",
      "value": "flight_time_s"
    },
    {
      "type": "metric",
      "name": "drift_m",
      "op": "sim",
      "sim": "flight",
      "value": "drift_m"
    },
    {
      "type": "on_input",
      "input": "launch",
      "do": [
        {
          "sim": "flight",
          "action": "play"
        }
      ]
    },
    {
      "type": "on_input",
      "input": "reset",
      "do": [
        {
          "sim": "flight",
          "action": "restart"
        }
      ]
    }
  ],
  "run": null
}