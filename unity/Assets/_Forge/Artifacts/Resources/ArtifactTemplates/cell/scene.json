        0,
        0.17,
        -0.13
      ],
      "height": 0.018,
      "color": "#FFE66D",
      "billboard": true,
      "visible": false
    },
    {
      "id": "step_2",
      "kind": "text",
      "text": "2  Ribosomes on the rough ER read the mRNA and build the protein",
      "pos": [
        0,
        0.17,
        -0.13
      ],
      "height": 0.018,
      "color": "#FFE66D",
      "billboard": true,
      "visible": false
    },
    {
      "id": "step_3",
      "kind": "text",
      "text": "3  The Golgi apparatus modifies the protein and packs it into a vesicle",
