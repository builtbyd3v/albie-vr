{
  "manifest": {
    "schema": "albie.artifact/1",
    "name": "Traffic Light",
    "version": 1,
    "description": "A traffic light with a button that cycles the light."
  },
  "scene": {
    "schema": "albie.scene/1",
    "nodes": [
      {
        "id": "light",
        "type": "group",
        "position": [
          0,
          1.5,
          0
        ],
        "children": [
          {
            "id": "red",
            "type": "cylinder",
            "position": [
              0,
              0.6,
              0
            ],
            "scale": [
              0.3,
              0.3,
              0.1
            ],
            "color": "#ff0000",
            "emissive": "#ff0000",
            "emissiveIntensity": 1
          },
          {
            "id": "yellow",
            "type": "cylinder",
            "position": [
              0,
              0,
              0
            ],
            "scale": [
              0.3,
              0.3,
              0.1
            ],
            "color": "#333333",
            "emissive": "#000000",
            "emissiveIntensity": 0
          },
          {
            "id": "green",
            "type": "cylinder",
            "position": [
              0,
              -0.6,
              0
            ],
            "scale": [
              0.3,
              0.3,
              0.1
            ],
            "color": "#333333",
            "emissive": "#000000",
            "emissiveIntensity": 0
          }
        ]
      },
      {
        "id": "pole",
        "type": "cylinder",
        "position": [
          0,
          0,
          0
        ],
        "scale": [
          0.08,
          2.5,
          0.08
        ],
        "color": "#444444"
      },
      {
        "id": "button",
        "type": "cylinder",
        "position": [
          0.8,
          0.2,
          0.4
        ],
        "scale": [
          0.25,
          0.08,
          0.25
        ],
        "color": "#cccccc",
        "onClick": "cycle"
      }
    ],
    "scripts": [
      {
        "id": "cycle",
        "trigger": "button.onClick",
        "actions": [
          {
            "type": "setState",
            "target": "light",
            "property": "phase",
            "operation": "next",
            "values": [
              "red",
              "yellow",
              "green"
            ]
          },
          {
            "type": "if",
            "condition": {
              "state": "light.phase",
              "equals": "red"
            },
            "then": [
              {
                "type": "setMaterial",
                "target": "red",
                "color": "#ff0000",
                "emissive": "#ff0000",
                "emissiveIntensity": 1
              },
              {
                "type": "setMaterial",
                "target": "yellow",
                "color": "#333333",
                "emissive": "#000000",
                "emissiveIntensity": 0
              },
              {
                "type": "setMaterial",
                "target": "green",
                "color": "#333333",
                "emissive": "#000000",
                "emissiveIntensity": 0
              }
            ]
          },
          {
            "type": "if",
            "condition": {
              "state": "light.phase",
              "equals": "yellow"
            },
            "then": [
              {
                "type": "setMaterial",
                "target": "red",
                "color": "#333333",
                "emissive": "#000000",
                "emissiveIntensity": 0
              },
              {
                "type": "setMaterial",
                "target": "yellow",
                "color": "#ffcc00",
                "emissive": "#ffcc00",
                "emissiveIntensity": 1
              },
              {
                "type": "setMaterial",
                "target": "green",
                "color": "#333333",
                "emissive": "#000000",
                "emissiveIntensity": 0
              }
            ]
          },
          {
            "type": "if",
            "condition": {
              "state": "light.phase",
              "equals": "green"
            },
            "then": [
              {
                "type": "setMaterial",
                "target": "red",
                "color": "#333333",
                "emissive": "#000000",
                "emissiveIntensity": 0
              },
              {
                "type": "setMaterial",
                "target": "yellow",
                "color": "#333333",
                "emissive": "#000000",
                "emissiveIntensity": 0
              },
              {
                "type": "setMaterial",
                "target": "green",
                "color": "#00ff00",
                "emissive": "#00ff00",
                "emissiveIntensity": 1
              }
            ]
          }
        ]
      }
    ]
  }
}