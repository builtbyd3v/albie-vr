[
{"name": "identity: app id and version", "group": "identity", "cmd": "ping", "wait_s": 0, "expect": {"app": "com.albie.vr", "version": "1.0.0"}, "warn_if": {"app": {"contains": "unity.template"}}},
{"name": "voice: no session open at idle (lazy)", "group": "voice", "cmd": "state", "wait_s": 0, "requires_state": {"voice.present": true}, "expect_state": {"voice.connected": false}},
{"name": "voice (paid): say opens a session", "group": "voice", "paid": true, "cmd": "say", "cmd_args": {"text": "Answer with one word: ready."}, "wait_s": 1, "within_s": 20, "requires_state": {"voice.present": true, "voice.held": false}, "expect_state": {"voice.connected": true}, "expect_logs": ["[AlbieVoice] connected to the voice service"]},
{"name": "voice (paid): closes about 35 s after the last word", "group": "voice", "paid": true, "cmd": "state", "wait_s": 0, "within_s": 90, "requires_state": {"voice.present": true}, "expect_state": {"voice.connected": false}, "expect_logs": ["[AlbieVoice] idle: closing the voice session"], "expect_elapsed": {"gte": 30, "lte": 70}},
{"name": "voice (paid): stays closed through 60 s of quiet", "group": "voice", "paid": true, "cmd": "state", "wait_s": 0, "steady_s": 60, "requires_state": {"voice.present": true}, "expect_state": {"voice.connected": false}, "forbid_logs": ["[AlbieVoice] connected to the voice service"]},
{"name": "setup: hold the voice (the sweep spends nothing)", "setup": true, "cmd": "voice_guard", "cmd_args": {"on": true}, "wait_s": 0.5, "expect_state": {"voice.held": true, "voice.connected": false}},
{"name": "setup: seat the user at the desk", "setup": true, "cmd": "desk", "cmd_args": {"seated": true}, "wait_s": 0.5, "within_s": 3, "expect_state": {"desk.room_loaded": true, "desk.state": "Seated"}},
{"name": "desk: ui_open_view cad while seated", "group": "desk", "tool": "ui_open_view", "args": {"view": "cad"}, "wait_s": 2, "expect": {"result.view": "cad"}, "expect_state": {"workspace.mode": "cad"}},
{"name": "desk: ui_open_view code while seated", "group": "desk", "tool": "ui_open_view", "args": {"view": "code"}, "wait_s": 2, "expect": {"result.view": "code"}, "expect_state": {"workspace.mode": "code"}},
{"name": "desk: ui_open_view ml while seated", "group": "desk", "tool": "ui_open_view", "args": {"view": "ml"}, "wait_s": 2, "expect": {"result.view": "ml"}, "expect_state": {"workspace.mode": "ml"}},
{"name": "desk: code_open_file opens the code view", "group": "desk", "tool": "code_open_file", "args": {"path": "rocket.py", "line": 1}, "wait_s": 1.5, "expect_state": {"workspace.mode": "code"}},
{"name": "desk: close the view", "group": "desk", "tool": "ui_open_view", "args": {"view": "none"}, "expect": {"result.view": ""}},
{"name": "first run: help_show opens the welcome card", "group": "first run", "tool": "help_show", "args": {}, "expect": {"result.status": "shown", "result.try": {"len": 3}}, "expect_state": {"first_run.card_shown": true}, "expect_window": "FirstRunCard"},
{"name": "first run: each try runs a registered tool", "group": "first run", "cmd": "first_run", "wait_s": 0, "expect": {"present": true, "tries": {"len": 3}, "tries.0.tool": "artifact_create", "tries.0.args": {"template": "slalom"}, "tries.0.registered": true, "tries.1.tool": "artifact_create", "tries.1.args": {"template": "heart"}, "tries.1.registered": true, "tries.2.tool": "brain_record", "tries.2.needs_truck": true, "tries.2.registered": true}},
{"name": "first run: 'drive it twice' with no truck says make a slalom first", "group": "first run", "cmd": "first_run", "cmd_args": {"tap": 2}, "wait_s": 0.5, "requires_state": {"first_run.truck_out": false}, "expect": {"last_said": "Make a slalom first. Then drive it twice and I'll learn it."}, "expect_logs": ["[FirstRun] Albie: Make a slalom first."]},
{"name": "first run: 'make me a slalom' asks for approval", "group": "first run", "cmd": "first_run", "cmd_args": {"tap": 0}, "wait_s": 1, "within_s": 8, "expect_state": {"first_run.last_said": {"contains": "needs your OK the first time"}, "first_run.card_shown": false, "first_run.orb_shown": true}},
{"name": "first run: slalom tool shape (approval nested under opened)", "group": "first run", "tool": "artifact_create", "args": {"template": "slalom"}, "wait_s": 1, "expect": {"result.opened.status": "awaiting_approval", "result.opened.asks": {"exists": true}}},
{"name": "first run: close the slalom", "group": "first run", "tool": "artifact_close", "args": {}},
{"name": "first run: 'show me a beating heart' opens it", "group": "first run", "cmd": "first_run", "cmd_args": {"tap": 1}, "wait_s": 1, "within_s": 8, "expect_state": {"first_run.last_said": {"contains": "Here's a beating heart."}}},
{"name": "first run: heart tool shape (opened)", "group": "first run", "tool": "artifact_create", "args": {"template": "heart"}, "wait_s": 2, "expect": {"result.opened.status": "open"}},
{"name": "first run: close the heart", "group": "first run", "tool": "artifact_close", "args": {}},
{"name": "first run: help_show reopens the card from the dot", "group": "first run", "tool": "help_show", "args": {}, "expect": {"result.status": "shown"}, "expect_state": {"first_run.card_shown": true, "first_run.orb_shown": false}},
{"name": "lifecycle: headset off stops game time and audio", "group": "lifecycle", "cmd": "lifecycle", "cmd_args": {"away": true}, "wait_s": 5, "expect_state": {"lifecycle.away": true, "lifecycle.time_scale": 0, "lifecycle.audio_paused": true, "voice.connected": false}, "expect_logs": ["[AppLifecycle] away (simulated headset off)"]},
{"name": "lifecycle: back after 5 s, no welcome line", "group": "lifecycle", "cmd": "lifecycle", "cmd_args": {"away": false}, "wait_s": 1, "expect_state": {"lifecycle.away": false, "lifecycle.time_scale": 1, "lifecycle.audio_paused": false, "lifecycle.last_away_s": {"lte": 15}}, "expect_logs": [{"text": "[AppLifecycle] back (simulated headset on) after", "count": 1}, {"text": "[DebugBridge] resumed after", "count": 1}], "forbid_logs": ["Welcome back"]},
{"name": "lifecycle: headset off for 25 s", "group": "lifecycle", "cmd": "lifecycle", "cmd_args": {"away": true}, "wait_s": 25, "expect_state": {"lifecycle.away": true, "lifecycle.time_scale": 0}},
{"name": "lifecycle: back after 25 s, Resumed once, welcome back said", "group": "lifecycle", "cmd": "lifecycle", "cmd_args": {"away": false}, "wait_s": 1, "within_s": 5, "expect_state": {"lifecycle.away": false, "lifecycle.time_scale": 1, "lifecycle.audio_paused": false, "lifecycle.last_away_s": {"gte": 24}, "voice.connected": false}, "expect_logs": [{"text": "[AppLifecycle] back (simulated headset on) after", "count": 1}, {"text": "[DebugBridge] resumed after", "count": 1}, {"text": "[FirstRun] Albie: Welcome back!", "count": 1}]},
{"name": "cloud: reports Offline while the Space is paused", "group": "cloud offline", "cmd": "state", "wait_s": 0, "within_s": 120, "expect_state": {"cloud.configured": true, "cloud.hub": "Mock", "cloud.state": "Offline"}},
{"name": "cloud: cad_list_parts answers the offline line within 10 s", "group": "cloud offline", "tool": "cad_list_parts", "args": {}, "timeout_s": 15, "wait_s": 0, "allow_tool_error": true, "expect": {"result.error": "CAD and model training are offline right now. Everything else on the headset still works."}, "expect_elapsed": {"lte": 10}},
{"name": "cloud: ml_status answers the offline line within 10 s", "group": "cloud offline", "tool": "ml_status", "args": {}, "timeout_s": 15, "wait_s": 0, "allow_tool_error": true, "expect": {"result.error": "CAD and model training are offline right now. Everything else on the headset still works."}, "expect_elapsed": {"lte": 10}},
{"name": "cloud: a headset-local artifact still opens", "group": "cloud offline", "tool": "artifact_create", "args": {"template": "dna"}, "wait_s": 2, "expect": {"result.opened.status": "open"}, "expect_state": {"cloud.state": "Offline"}},
{"name": "cloud: close the artifact", "group": "cloud offline", "tool": "artifact_close", "args": {}},
{"name": "messages: the view opens chat and Mentions (demo data)", "group": "messages", "tool": "ui_open_view", "args": {"view": "messages"}, "wait_s": 2.5, "within_s": 5, "expect": {"result.view": "messages"}, "expect_state": {"workspace.mode": "messages", "messages.demo": true, "messages.channels": {"gte": 5}, "windows": {"any": {"id": "messages"}}}, "expect_window": "messages-mentions"},
{"name": "messages: open general", "group": "messages", "tool": "messages_open", "args": {"channel": "general"}, "expect": {"result.opened": "general", "result.kind": "channel"}},
{"name": "messages: messages_send makes a draft and sends nothing", "group": "messages", "tool": "messages_send", "args": {"channel": "general", "text": "Headset sweep: this goes out exactly once."}, "wait_s": 1, "expect": {"result.status": "awaiting_confirmation", "result.draft_id": {"exists": true}, "result.channel_name": "general"}, "expect_state": {"messages.open_draft": {"exists": true}}, "forbid_logs": ["[MessagesDemo] sent"]},
{"name": "messages: messages_confirm sends it once", "group": "messages", "tool": "messages_confirm", "args": {"send": true}, "wait_s": 1, "expect": {"result.status": "sent", "result.ts": {"exists": true}}, "expect_state": {"messages.open_draft": null}, "expect_logs": [{"text": "[MessagesDemo] sent", "count": 1}]},
{"name": "messages: a second confirm sends nothing", "group": "messages", "tool": "messages_confirm", "args": {"send": true}, "allow_tool_error": true, "expect": {"result.error": {"contains": "no open draft"}}, "forbid_logs": ["[MessagesDemo] sent"]},
{"name": "messages: a provider argument is ignored", "group": "messages", "tool": "messages_send", "args": {"channel": "general", "text": "Provider argument test.", "provider": "imessage", "source": "imessage"}, "expect": {"result.status": "awaiting_confirmation", "result.channel_name": "general"}},
{"name": "messages: cancel that draft", "group": "messages", "tool": "messages_confirm", "args": {"send": false}, "expect": {"result.status": "cancelled"}, "forbid_logs": ["[MessagesDemo] sent"]},
{"name": "messages: an im: conversation is refused", "group": "messages", "tool": "messages_send", "args": {"channel": "im:+15550100", "text": "Must not become a draft."}, "allow_tool_error": true, "expect": {"result.error": {"exists": true}}, "expect_state": {"messages.open_draft": null}},
{"name": "messages: control, an injected demo message appears", "group": "messages", "cmd": "inject", "cmd_args": {"type": "notify.message", "payload": {"source": "slack", "channel": "C0GENERAL", "channel_name": "general", "user": "U0SWEEP", "user_name": "Sweep Bot", "text": "Injected by the headset sweep.", "ts": "4102444800.000001"}}, "wait_s": 1, "expect_state": {"messages.newest_ts": "4102444800.000001"}},
{"name": "messages: an injected item with source imessage does not appear", "group": "messages", "cmd": "inject", "cmd_args": {"type": "notify.message", "payload": {"source": "imessage", "channel": "C0GENERAL", "channel_name": "general", "user": "U0SWEEP", "user_name": "Sweep Bot", "text": "Must be dropped (source).", "ts": "4102444800.000002"}}, "wait_s": 1, "expect_state": {"messages.newest_ts": "4102444800.000001", "messages.recent_im": 0, "messages.recent_sources": {"not_contains": "imessage"}}},
{"name": "messages: an injected im: conversation does not appear", "group": "messages", "cmd": "inject", "cmd_args": {"type": "notify.message", "payload": {"source": "slack", "channel": "im:+15550100", "channel_name": "general", "user": "U0SWEEP", "user_name": "Sweep Bot", "text": "Must be dropped (im: id).", "ts": "4102444800.000003"}}, "wait_s": 1, "expect_state": {"messages.newest_ts": "4102444800.000001", "messages.recent_im": 0, "messages.im_channels": 0}},
{"name": "messages: close the view", "group": "messages", "tool": "ui_open_view", "args": {"view": "none"}, "expect": {"result.view": ""}},
{"name": "teardown: stand the user up", "teardown": true, "cmd": "desk", "cmd_args": {"seated": false}, "wait_s": 0.5, "expect_state": {"desk.force_seated": false}},
{"name": "teardown: give the voice back", "teardown": true, "cmd": "voice_guard", "cmd_args": {"on": false}, "wait_s": 0.5, "expect_state": {"voice.held": false}},
{"name": "manual: headset off for 2 minutes, then on", "group": "manual", "manual": true, "steps": ["Start a recording, wear the headset, open the welcome card (say 'help').", "Take the headset off and put it on the table for 2 minutes.", "Put it back on. Albie says welcome back and what you were doing. Nothing you left open has moved or timed out. The back line ends with 'after 1xx s'."], "look_for": ["[AppLifecycle] away (", "[AlbieVoice] suspended", "[AppLifecycle] back (", "[FirstRun] Albie: Welcome back!"]},
{"name": "manual: face Albie and talk (costs voice credits)", "group": "manual", "manual": true, "steps": ["Face Albie and say 'make me a beating heart'. He answers and the heart opens.", "Stay quiet and keep facing away for about a minute.", "About 35 s after his last word the idle close line appears, and no new connect line follows while you stay quiet."], "look_for": ["[AlbieVoice] connected to the voice service from the device.", "[AlbieVoice] idle: closing the voice session"]},
{"name": "manual: pinch-drive a lap", "group": "manual", "manual": true, "steps": ["Say 'make me a slalom' and tap Allow on the approval sheet.", "Pinch your right hand to drive, tilt it to steer, pinch your left hand to reverse. Drive one full lap.", "On the laptop run: python3 tools/questbridge.py call brain_status. completed_laps is 1 or more."], "look_for": ["[FirstRun] Albie: Your truck is out."]}
]
