# Copy to hub/.env. All optional except ANTHROPIC_API_KEY in real mode.
ANTHROPIC_API_KEY=
# ML project setup: Jev classifies the repo's type (without it, Claude classifies); Claude writes the adapter
TYPESAFE_API_KEY=
# 1 = scripted events, no model calls (Unity integration / demos without a key)
FAKE_AGENT=1
# Model for the Claude Agent SDK runner
AGENT_MODEL=claude-sonnet-5-5
# Reasoning effort: low | medium | high | xhigh | max (low keeps Q&A snappy)
AGENT_QA_EFFORT=low
AGENT_CODE_EFFORT=medium
# Project used when a client does not send project_id (sandbox = Albie's sandbox, sandbox/setup.sh)
DEFAULT_PROJECT=sandbox
# Override the projects file location
PROJECTS_FILE=config/projects.yaml
# The demo GitHub account's token. The headset code browser (/code/*) reads repos and approves or merges pull
# requests with it; the ML import uses it for its public repo reads.
GITHUB_TOKEN=
# Optional end-to-end coding workflow destination (owner/repository); keep credentials in this file on the hub only.
GITHUB_USER=
BUILD_REPO=
# claude uses the existing Claude Agent SDK in a separate checkout; openhands uses a Docker sandbox.
BUILD_EXECUTOR=claude
# Install requirements-openhands.txt in a separate Python 3.12+ environment and set its absolute Python path.
OPENHANDS_PYTHON=
OPENHANDS_MODEL=anthropic/claude-sonnet-5-5
OPENHANDS_SERVER_IMAGE=ghcr.io/openhands/agent-server:latest-python
# Preset repo buttons on the ML Training panel (up to 4): "Label|https://github.com/owner/repo;Label|https://github.com/..."
# Empty = Forge CIFAR demo + PyTorch examples. A preset is imported as soon as it's pressed.
FORGE_ML_GITHUB_PRESETS=
# Also emit the existing-contract pet.say after agent.answer_done (0/1). Off by default to avoid double captions.
AGENT_EMIT_PET_SAY=0
# Speech-to-text: none | whisper  (whisper needs `pip install faster-whisper`, see requirements.txt)
STT_PROVIDER=none
WHISPER_MODEL=small
# Speech-to-speech voice (agent/voice.py): none | grok | fake
#   none: stt.py + Claude runner (above), no spoken replies
#   grok: Grok Voice session per Unity socket (needs XAI_API_KEY); transcripts -> stt.*, speech -> tts.* + binary PCM16
#   fake: canned transcript + reply spoken from agent/assets/fake_voice_24k.pcm (no key, no network)
VOICE_PROVIDER=none
XAI_API_KEY=
GROK_VOICE_MODEL=grok-voice-3.0
# Voice name from GET https://api.x.ai/v1/tts/voices (empty = xAI default "eve"). For a cartoony Albie try
# sirius ("quick-witted, playful"), then cosmo / iris; a cloned custom voice id also works here.
GROK_VOICE=sirius
# Speaking speed 0.7..1.5. Unity pitches the voice up (StreamedPcmTextToSpeech.pitch, default 1.2 = cartoony),
# which also speeds it up, so keep this around 1/pitch for a natural pace (1.2 -> 0.85).
GROK_VOICE_SPEED=0.85
# Speech output rate when the client doesn't send hello.audio_out_rate (8000..48000)
GROK_VOICE_OUT_RATE=48000
# Close the Grok socket after this many idle seconds ($0.08/min while open); it reconnects on the next turn
VOICE_IDLE_CLOSE_S=120
# fake provider pacing: 1.0 = real time, 0 = instant (tests)
FAKE_VOICE_PACE=1.0
# Crew (agent/crew.py): each crew code task gets its own git worktree on pet/<agent>/<task>. Default dir:
# a sibling of the repo, <repo>-crew/ (e.g. ~/Documents/gatorhack-dubz-crew). Clean up: git worktree prune
AGENT_WORKTREE_DIR=
LOG_LEVEL=INFO
# Albie's sandbox (sandbox/setup.sh prints these). ${HOME} is expanded when the hub loads this file.
# The CAD design opened the first time (the hub watches its folder and rebuilds on save)
FORGE_CAD_SCRIPT=${HOME}/Documents/GitHub/albie-sandbox/cad/rocket.py
# The ML project the ML desk opens
FORGE_ML_REPO=${HOME}/Documents/GitHub/albie-sandbox/ml
# Python env with torch for repos Albie pulls from GitHub (ml_github): linked as the clone's .venv. Change the path if
# your clone is not ~/Documents/GitHub/gatorhack-dubz
FORGE_ML_VENV=${HOME}/Documents/GitHub/gatorhack-dubz/ml-examples/cifar10/.venv
# ml_improve source: auto (Claude, scripted change if Claude fails) | scripted | llm
FORGE_ML_IMPROVE=auto
# Hub data (CAD versions, ML runs, messages); default hub/.data
FORGE_DATA_DIR=
# Voice turn rules: 1 = only turns that say an agent's name are answered (default 0 = free speech)
VOICE_NAME_REQUIRED=0
# 1 = facing Albie when you start talking counts as naming him
VOICE_FACING=0
# Cut a spoken reply after this many seconds of audio (0 = no cut)
VOICE_MAX_REPLY_S=0
# Fake agent pacing in seconds (FAKE_AGENT=1)
FAKE_AGENT_DELAY=0.6
# ML desk setup: repo classifier jev | claude (default: jev when TYPESAFE_API_KEY is set, else claude)
FORGE_CLASSIFIER=
# Models for the ML setup (defaults: claude-opus-5-5, jev-1.14.0)
FORGE_LLM_MODEL=
FORGE_JEV_MODEL=
# Extra ML project folders Albie can open by name, separated by ':'
FORGE_ML_PROJECTS=
# Where a training run posts back (default: this machine on the hub's --port)
FORGE_HUB_SELF=
# Slack (messaging module, PROJECT_CONTEXT 8.7). Bot + app tokens empty = messaging disabled, hub still boots.
# Both written by `slack run` from hub/ (scripts/slack_cli_start.py): the app's bot identity and the Socket Mode token
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# PER PERSON. YOUR token (xoxp-...): Albie reads your inbox and posts replies under your name. The CLI never hands it out:
# `slack app settings` > OAuth & Permissions > User OAuth Token. Empty = Albie reads only channels it was invited to
# and posts as "Albie" (one warning at startup).
SLACK_USER_TOKEN=
# Optional: your member id. Derived from SLACK_USER_TOKEN when set; only needed without it (mentions_me = <@id> in text)
SLACK_USER_ID=
# Channel id or #name drafts go to when neither the tool nor the replied-to message names one
SLACK_DEFAULT_CHANNEL=#forge-team
# Optional iMessage support (macOS only; OFF unless IMESSAGE_ENABLED=1). Grant Full Disk Access to the app running
# the hub in System Settings > Privacy & Security, then restart. Reading needs nothing else. Sending needs the imsg CLI,
# which the hub never installs: `brew install steipete/tap/imsg` (third-party tap). The first send may ask for
# Automation permission to control Messages.
# IMESSAGE_ENABLED=1
# PER PERSON (your own contacts). Required privacy allowlist: only 1:1 chats with these phones/emails are read or sent to. Empty = nothing loads.
# Group chats are always hidden. Any phone format works; a bare 10-digit number is US (+1).
# IMESSAGE_ALLOW=+1 352 555 0123,friend@example.com
# IMESSAGE_DB=~/Library/Messages/chat.db
# IMESSAGE_POLL_MS=1000
# IMESSAGE_RECENT_DAYS=3
# IMESSAGE_DIGEST=false
# IMESSAGE_CLI=imsg  # optional override for a custom executable
